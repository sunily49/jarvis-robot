# ══════════════════════════════════════════════════════════════════════
# JARVIS Robot — Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# ══════════════════════════════════════════════════════════════════════

# ── API Keys (required) ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── Triggers (true/false) ────────────────────────────────────────────
TRIGGER_WAKEWORD=true
TRIGGER_BUTTON=true
TRIGGER_FACE=true
TRIGGER_CLAP=false
TRIGGER_PIR=false
TRIGGER_TELEGRAM=false

# ── AI ────────────────────────────────────────────────────────────────
AI_GEMINI_LIVE=true
AI_GEMINI_FLASH=true
AI_OLLAMA_FALLBACK=true

# ── Vision (offloaded to server) ─────────────────────────────────────
VISION_FACE_RECOGNITION=true
VISION_YOLO=false
VISION_GESTURE=false
VISION_ANOMALY=false

# ── MCP Tools ─────────────────────────────────────────────────────────
TOOL_MUSIC=false
TOOL_WEB_SEARCH=true
TOOL_HOME_ASSISTANT=false
TOOL_MOTOR=false
TOOL_GPIO=false
TOOL_CAMERA_PTZ=true
TOOL_MEMORY=true

# ── Hardware ──────────────────────────────────────────────────────────
HW_MOTORS=false
HW_SERVOS=false
HW_SENSORS=false

# ── Server ────────────────────────────────────────────────────────────
SERVER_ENABLED=true
SERVER_HOST=jarvis-server.local
SERVER_PORT=9000
SERVER_HEALTH_INTERVAL=30

# ── Audio ─────────────────────────────────────────────────────────────
AUDIO_DEVICE_INDEX=-1
AUDIO_SAMPLE_RATE=48000
AUDIO_TARGET_RATE=16000
AUDIO_CHUNK_SIZE=1024

# ── Wake Word ─────────────────────────────────────────────────────────
WAKEWORD_MODEL_PATH=/home/admin/wakeword_models/hey_jarvis.onnx
WAKEWORD_THRESHOLD=0.7

# ── TTS (Piper — fallback/announcements only) ────────────────────────
PIPER_MODEL_PATH=/home/admin/piper_models/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=/home/admin/piper_models/en_US-lessac-medium.onnx.json

# ── Camera ────────────────────────────────────────────────────────────
CAMERA_DEVICE=/dev/video0
CAMERA_FRAME_WIDTH=640
CAMERA_FRAME_HEIGHT=480
CAMERA_CAPTURE_INTERVAL=5

# ── GPIO Pins ─────────────────────────────────────────────────────────
GPIO_BUTTON_PIN=17
GPIO_PIR_PIN=27
GPIO_RELAY_PINS=22,23,24,25
GPIO_EMERGENCY_STOP_PIN=5

# ── Motors ────────────────────────────────────────────────────────────
MOTOR_ENA_PIN=12
MOTOR_IN1_PIN=6
MOTOR_IN2_PIN=13
MOTOR_ENB_PIN=18
MOTOR_IN3_PIN=19
MOTOR_IN4_PIN=26
MOTOR_MAX_SPEED=80

# ── Trigger Manager ──────────────────────────────────────────────────
TRIGGER_COOLDOWN=3.0

# ── MQTT / Home Assistant ────────────────────────────────────────────
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Memory ────────────────────────────────────────────────────────────
MEMORY_DB_PATH=/home/admin/jarvis/data/jarvis.db
MEMORY_SHORT_TERM_LIMIT=5
MEMORY_RETENTION_DAYS=30

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Display (HDMI) ────────────────────────────────────────────────────
DISPLAY_ENABLED=false
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
DISPLAY_FPS=30
DISPLAY_FULLSCREEN=true
DISPLAY_BRIGHTNESS=80
DISPLAY_IDLE_TIMEOUT=300

# ── MCP Server ────────────────────────────────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8080
