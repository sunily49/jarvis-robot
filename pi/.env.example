# ══════════════════════════════════════════════════════════════════════
# JARVIS Robot — Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
#
# ARCHITECTURE
# ─────────────────────────────────────────────────────────────────────
# Pi-only mode (default): everything runs on the Raspberry Pi.
#   Gemini Live handles conversation via cloud API.
#   Face detection uses Haar cascade (presence only, no identification).
#   TTS uses local Piper model.
#
# Pi + Server mode: set SERVER_ENABLED=true and point SERVER_HOST to
#   your home server. The server handles face identification, voice
#   recognition, YOLO object detection, and Ollama LLM fallback.
# ══════════════════════════════════════════════════════════════════════

# ── API Keys (required) ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=123456789,987654321

# ── Triggers ─────────────────────────────────────────────────────────
TRIGGER_WAKEWORD=true
TRIGGER_BUTTON=true
TRIGGER_FACE=true
TRIGGER_CLAP=false
TRIGGER_PIR=false
TRIGGER_TELEGRAM=false

# ── AI ────────────────────────────────────────────────────────────────
AI_GEMINI_LIVE=true
AI_GEMINI_FLASH=true
# Ollama fallback requires either the home server (SERVER_ENABLED=true)
# or a local Ollama install. Disabled by default in Pi-only mode.
AI_OLLAMA_FALLBACK=false
# Gemini Live model — override here if the default changes
# GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001

# ── Vision ────────────────────────────────────────────────────────────
# Face DETECTION (Haar cascade) always runs on Pi and costs ~8% CPU.
# Face IDENTIFICATION (name recognition) requires the home server.
# Set false in Pi-only mode — face detection still works for triggering.
VISION_FACE_RECOGNITION=false
# These all require the home server:
VISION_YOLO=false
VISION_GESTURE=false
VISION_ANOMALY=false

# ── MCP Tools ─────────────────────────────────────────────────────────
TOOL_MUSIC=false
TOOL_WEB_SEARCH=true
TOOL_HOME_ASSISTANT=false
TOOL_MOTOR=false
TOOL_GPIO=false
TOOL_CAMERA_PTZ=true
TOOL_MEMORY=true

# ── Hardware ──────────────────────────────────────────────────────────
HW_MOTORS=false
HW_SERVOS=false
HW_SENSORS=false

# ── Home Server (Pi + Server mode only) ──────────────────────────────
# Set SERVER_ENABLED=true if you have a home server running jarvis-server.
# In Pi-only mode leave this false — it avoids DNS lookups and timeouts.
SERVER_ENABLED=false
SERVER_HOST=jarvis-server.local
SERVER_PORT=9000
SERVER_HEALTH_INTERVAL=30

# ── Audio ─────────────────────────────────────────────────────────────
AUDIO_DEVICE_INDEX=-1
AUDIO_SAMPLE_RATE=48000
AUDIO_TARGET_RATE=16000
AUDIO_CHUNK_SIZE=1024

# ── Wake Word ─────────────────────────────────────────────────────────
# Path is auto-discovered from ~/wakeword_models/ if not set.
# WAKEWORD_MODEL_PATH=/home/vedant/wakeword_models/hey_jarvis_v0.1.onnx
WAKEWORD_THRESHOLD=0.5

# ── TTS (Piper — announcements and fallback) ─────────────────────────
PIPER_MODEL_PATH=/home/vedant/piper_models/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=/home/vedant/piper_models/en_US-lessac-medium.onnx.json

# ── Camera ────────────────────────────────────────────────────────────
CAMERA_DEVICE=/dev/video0
CAMERA_FRAME_WIDTH=640
CAMERA_FRAME_HEIGHT=480
CAMERA_CAPTURE_INTERVAL=5

# ── GPIO Pins ─────────────────────────────────────────────────────────
GPIO_BUTTON_PIN=17
GPIO_PIR_PIN=27
GPIO_RELAY_PINS=22,23,24,25
GPIO_EMERGENCY_STOP_PIN=5

# ── Motors ────────────────────────────────────────────────────────────
MOTOR_ENA_PIN=12
MOTOR_IN1_PIN=6
MOTOR_IN2_PIN=13
MOTOR_ENB_PIN=18
MOTOR_IN3_PIN=19
MOTOR_IN4_PIN=26
MOTOR_MAX_SPEED=80

# ── Trigger Manager ──────────────────────────────────────────────────
TRIGGER_COOLDOWN=3.0

# ── MQTT / Home Assistant ────────────────────────────────────────────
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Memory ────────────────────────────────────────────────────────────
MEMORY_DB_PATH=/home/vedant/jarvis/data/jarvis.db
MEMORY_SHORT_TERM_LIMIT=5
MEMORY_RETENTION_DAYS=30

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Display (HDMI face animation) ────────────────────────────────────
DISPLAY_ENABLED=true
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
DISPLAY_FPS=30
DISPLAY_FULLSCREEN=false
DISPLAY_BRIGHTNESS=80
DISPLAY_IDLE_TIMEOUT=300

# ── MCP Server ────────────────────────────────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8080
